# Vamos gerar o ficheiro PDF da Ficha de Trabalho usando Python
import os
from reportlab.lib.pagesizes import letter
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, KeepTogether
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
from reportlab.lib import colors

pdf_filename = "Ficha_Ciencias_7Ano.pdf"
doc = SimpleDocTemplate(pdf_filename, pagesize=letter, rightMargin=40, leftMargin=40, topMargin=40, bottomMargin=40)
story = []

styles = getSampleStyleSheet()

# Estilos Personalizados
title_style = ParagraphStyle('TitleStyle', parent=styles['Heading1'], fontSize=18, leading=22, textColor=colors.HexColor("#1A365D"), alignment=1)
subtitle_style = ParagraphStyle('SubTitleStyle', parent=styles['Normal'], fontSize=11, leading=14, alignment=1, textColor=colors.HexColor("#4A5568"))
group_style = ParagraphStyle('GroupStyle', parent=styles['Heading2'], fontSize=13, leading=16, textColor=colors.HexColor("#2B6CB0"), spaceBefore=12, spaceAfter=6, keepWithNext=True)
question_style = ParagraphStyle('QuestionStyle', parent=styles['Normal'], fontSize=10.5, leading=15, spaceBefore=6, spaceAfter=4, keepWithNext=True)
text_style = ParagraphStyle('TextStyle', parent=styles['Normal'], fontSize=10, leading=14, leftIndent=15)

# Cabeçalho
story.append(Paragraph("<b>FICHA DE PREPARAÇÃO PARA O TESTE: CIÊNCIAS NATURAIS (7.º ANO)</b>", title_style))
story.append(Paragraph("Estudo do Manual - A Terra, a Atmosfera e os Subsistemas", subtitle_style))
story.append(Spacer(1, 15))

# GRUPO I
story.append(Paragraph("<b>GRUPO I – A TERRA NO ESPAÇO E CONDIÇÕES PARA A VIDA</b>", group_style))

q1 = [
    Paragraph("<b>1.</b> Todas as estrelas que observamos no céu noturno, à vista desarmada, localizam-se na Via Láctea. Sabendo que a Via Láctea é uma galáxia em espiral, <b>caracteriza</b> sumariamente a constituição geral de uma galáxia com base no teu manual.", question_style),
    Spacer(1, 40)
]
story.append(KeepTogether(q1))

q2 = [
    Paragraph("<b>2.</b> A localização da Terra no Sistema Solar foi determinante para a origem e manutenção da vida. <b>Explica as consequências</b> que ocorreriam na Terra se o nosso planeta se localizasse:", question_style),
    Paragraph("<b>a)</b> Muito mais perto do Sol.", text_style),
    Spacer(1, 25),
    Paragraph("<b>b)</b> Muito mais afastado do Sol.", text_style),
    Spacer(1, 25)
]
story.append(KeepTogether(q2))

q3 = [
    Paragraph("<b>3.</b> Associa cada elemento da coluna A à respetiva função protetora ou estrutural descrita na coluna B:", question_style),
    Paragraph("<b>Coluna A:</b><br/>I. Planetas Gigantes (Júpiter)<br/>II. Atmosfera Terrestre<br/>III. Massa da Terra", text_style),
    Paragraph("<b>Coluna B:</b><br/>a) Produz uma força de gravidade elevada, suficiente para reter a atmosfera.<br/>b) Atraem a maioria dos corpos rochosos como asteroides e cometas, protegendo a Terra de impactos.<br/>c) Protege a Terra do impacto de meteoritos através do atrito, causando a sua fragmentação.", text_style),
    Spacer(1, 35)
]
story.append(KeepTogether(q3))

# GRUPO II
story.append(Paragraph("<b>GRUPO II – EVOLUÇÃO DA ATMOSFERA E EFEITO DE ESTUFA</b>", group_style))

q4 = [
    Paragraph("<b>4.</b> A atmosfera primitiva passou por várias fases. Na primeira fase, gases como o hidrogénio e o hélio escaparam para o espaço. <b>Indica as duas razões</b> apresentadas no teu manual para que essa fuga tenha acontecido.", question_style),
    Spacer(1, 35)
]
story.append(KeepTogether(q4))

q5 = [
    Paragraph("<b>5.</b> Há cerca de 2800 milhões de anos (Ma), evoluíram organismos fundamentais para a alteração da composição da atmosfera: as cianobactérias.", question_style),
    Paragraph("<b>a)</b> <b>Identifica o processo biológico</b> realizado por estas bactérias que permitiu a libertação de oxigénio.", text_style),
    Spacer(1, 25),
    Paragraph("<b>b)</b> <b>Descreve</b> como se formou a camada de ozono (\(\text{O}_3\)) a partir do momento em que o oxigénio se acumulou na atmosfera.", text_style),
    Spacer(1, 35)
]
story.append(KeepTogether(q5))

q6 = [
    Paragraph("<b>6.</b> O efeito de estufa é um processo natural. De acordo com o manual, qual seria a temperatura média global da Terra <b>sem o efeito de estufa</b> e qual tem sido a temperatura média real devido a este fenómeno?", question_style),
    Spacer(1, 35)
]
story.append(KeepTogether(q6))

# GRUPO III
story.append(Paragraph("<b>GRUPO III – SUBSISTEMAS DA TERRA E SOLOS</b>", group_style))

q7 = [
    Paragraph("<b>7.</b> <b>Justifica a seguinte afirmação:</b> 'A Terra é considerada um sistema composto por quatro subsistemas principais que se encontram em equilíbrio dinâmico.'", question_style),
    Spacer(1, 40)
]
story.append(KeepTogether(q7))

q8 = [
    Paragraph("<b>8.</b> Faz a correspondência correta entre os Horizontes do Solo e as suas características:", question_style),
    Paragraph("<b>(1) Horizonte O</b>  |  <b>(2) Horizonte A</b>  |  <b>(3) Horizonte B</b>  |  <b>(4) Horizonte C</b>", text_style),
    Paragraph("[   ] Camada profunda com grande percentagem de matéria mineral, onde penetram algumas raízes.", text_style),
    Paragraph("[   ] Camada constituída por fragmentos de rochas, sendo a mais próxima da rocha-mãe.", text_style),
    Paragraph("[   ] Camada mais superficial, também designada húmus, sendo muito fértil.", text_style),
    Paragraph("[   ] Camada escurecida devido a possuir uma grande percentagem de matéria orgânica.", text_style),
    Spacer(1, 10)
]
story.append(KeepTogether(q8))

q9 = [
    Paragraph("<b>9.</b> O permafrost é o solo típico das regiões de clima polar.", question_style),
    Paragraph("<b>a)</b> <b>Explica</b> qual é o impacto do aquecimento global neste tipo específico de solo.", text_style),
    Spacer(1, 35),
    Paragraph("<b>b)</b> <b>Refere</b> qual é a grande preocupação ambiental e de saúde pública associada ao degelo do permafrost.", text_style),
    Spacer(1, 35)
]
story.append(KeepTogether(q9))

# Construir PDF
doc.build(story)
